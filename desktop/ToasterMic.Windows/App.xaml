<Application x:Class="ToasterMic.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#BDF477"/>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#111714"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,6,0,14"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#111714"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#BDF477"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111714"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDEFE9"/><Setter Property="FontSize" Value="14"/></Style>
  </Application.Resources>
</Application>
