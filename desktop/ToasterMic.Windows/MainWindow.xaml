<Window x:Class="ToasterMic.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Toaster Mic" Width="520" Height="600" MinWidth="460" MinHeight="580" Background="#111714" Foreground="#EDEFE9" FontFamily="Segoe UI" Closing="OnClosing">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,24">
   <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Einstellungen" Click="SettingsClick" Background="#D4DCD6" HorizontalAlignment="Right"/>
   <TextBlock Text="Toaster Mic" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <Border Grid.Row="1" Background="#1F2A23" Padding="16" CornerRadius="8" Margin="0,0,0,22"><StackPanel>
   <TextBlock x:Name="StatusText" Text="Bereit" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="StatsText" Text="Mikrofon auf dem Handy starten." Margin="0,6,0,0" Foreground="#ACB8AF"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="2" x:Name="ConnectionSettings">
   <TextBlock Text="Handy-IP"/><TextBox x:Name="HostBox" Text="192.168.1.100"/>
   <TextBlock x:Name="OutputText" Text="Audiogeräte werden geladen …" Foreground="#ACB8AF" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,14">
   <DockPanel Margin="0,0,0,10"><TextBlock x:Name="GainText" DockPanel.Dock="Right" Text="100 % · 0 dB" HorizontalAlignment="Right"/><TextBlock Text="Lautstärke"/></DockPanel>
   <Slider x:Name="GainSlider" Minimum="0" Maximum="1000" Value="100" TickFrequency="25" SmallChange="25" LargeChange="100" ValueChanged="OnGainChanged"/>
   <ProgressBar x:Name="Meter" Maximum="32768" Height="6" Margin="0,12,0,12" Foreground="#BDF477" Background="#2C3930"/>
   <CheckBox x:Name="MuteBox" Content="Stumm" Checked="OnMuteChanged" Unchecked="OnMuteChanged"/>
  </StackPanel>
  <Button Grid.Row="4" x:Name="ConnectButton" Content="Verbinden" Click="ConnectClick" IsEnabled="False"/>
 </Grid>
</Window>
