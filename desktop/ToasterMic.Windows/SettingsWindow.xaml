<Window x:Class="ToasterMic.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Einstellungen" Width="470" Height="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#111714" Foreground="#EDEFE9" FontFamily="Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Audioziel"/><ComboBox x:Name="OutputBox" DisplayMemberPath="Name"/>
   <TextBlock Text="VB-CABLE: hier CABLE Input, im Zielprogramm CABLE Output." TextWrapping="Wrap" Foreground="#ACB8AF" Margin="0,0,0,16"/>
   <TextBlock Text="Netzwerkpuffer"/><ComboBox x:Name="BufferBox"><ComboBoxItem Content="Ab 5 ms · automatisch"/><ComboBoxItem Content="Ab 15 ms · automatisch"/><ComboBoxItem Content="Ab 30 ms · automatisch"/><ComboBoxItem Content="Ab 60 ms · automatisch"/></ComboBox>
   <TextBlock Text="UDP-Port"/><TextBox x:Name="PortBox"/>
   <TextBlock x:Name="ErrorText" Foreground="#FFB4A8" TextWrapping="Wrap"/>
  </StackPanel>
  <Button Grid.Row="1" Content="Fertig" IsDefault="True" Click="SaveClick"/>
 </Grid>
</Window>
